{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node app/landing/build-preview.mjs",
  "outputDirectory": ".",
  "cleanUrls": false,
  "trailingSlash": false,
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "coleta/grades.py",
      "excludeFiles": "{app,assets,data,motor}/**"
    },
    "api/pacote.py": {
      "maxDuration": 60,
      "includeFiles": "coleta/grades.py",
      "excludeFiles": "{app,assets,data,motor}/**"
    },
    "api/status.py": {
      "maxDuration": 15,
      "includeFiles": "coleta/grades.py",
      "excludeFiles": "{app,assets,data,motor}/**"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/:path*" },
    { "source": "/", "destination": "/app/apresentacao.html" },
    { "source": "/apresentacao", "destination": "/app/apresentacao.html" },
    { "source": "/explorar", "destination": "/app/plataforma.html" },
    { "source": "/(.*)", "destination": "/app/$1" }
  ]
}
