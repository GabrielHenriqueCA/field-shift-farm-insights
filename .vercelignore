# Vercel Ignore File
# Ignora caches, ambientes locais e dados analiticos pesados
# Apenas os dados e o motor analitico na raiz; app/data e app/js/motor sao publicos.
/data/
# Midia do README (logos, prints, video do pitch, ~18 MB). O site nao usa: todas as rotas vao para /app/.
# Fora daqui ela entrava no pacote da funcao Python e estourava o limite de 225 MB.
/assets/
/motor/
.venv/
**/__pycache__/
*.pyc
*.parquet

# Scripts locais em app/ (servidor de dev local e preparacao)
app/**/*.py
app/*.py

# Bloqueia coleta local, liberando apenas coleta/grades.py para as funcoes serverless
/coleta/*
!/coleta/grades.py
